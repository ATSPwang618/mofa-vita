function check(v,s) { if(!v) throw s; }
Plugins.link('drawdeviceD3D.dll');
check(Motion.getD3DAvailable() && Motion.MaskModeAlpha==1, 'Motion dependency');
check(!Plugins.unlink('emoteplayer.dll'), 'dependency retention');
Plugins.link('motionPlayer.dll');
Motion.enableD3D=true; check(Motion.enableD3D, 'namespace property');
var rm=new Motion.ResourceManager(null,0), meta=rm.load('emote.mdf');
check(meta.spec=='krkr' && meta===rm.load('emote.mdf'), 'MDF resource/cache');
System.exitOnWindowClose=false;
var w=new Window(), root=new Layer(w,null), output=new Layer(w,root);
root.setSize(32,32); output.setSize(32,32); output.setImageSize(32,32);
var p=new Motion.EmotePlayer(rm); p.play('',0); p.draw(output); p.progress(20); p.draw(output);
check(p.animating && p.getVariableFrameList('face').count==2, 'player/metadata');
p.setVariable('face',0.75); check(p.getVariable('face')==0.75,'variable');
var canvas=new Motion.D3DAdaptor(w,32,32,16,16);
p.progress(20); p.draw(canvas); canvas.captureCanvas(output);
canvas.unloadUnusedTextures(); canvas.captureCanvas(output);
var separate=new Motion.SeparateLayerAdaptor(root);
p.progress(20); p.draw(separate);
p.progress(20); p.draw(output);
invalidate canvas; invalidate separate;
var manager=new Layer(w,root); manager.parent=null; manager.setSize(32,32); manager.setImageSize(32,32);
manager.type=2; manager.visible=true; manager.fillRect(0,0,32,32,0x20000040);
var d=new D3D(32,32), layer=new D3DLayer(d), image=new D3DImage(d);
image.load(output); check(image.width==32 && image.height==32,'D3DImage upload');
var picture=new D3DPicture(layer,image); picture.assignImageRange(0,0,32,32,-16,-16);
var e=new D3DEmotePlayer(layer); e.load('emote.mdf'); e.show(); e.progress(1); e.progress(1);
e.setVariable('face',0.5); check(e.getVariable('face')==0.5, 'D3D forwarding');
check(e.contains('touch',0,0), 'D3D hit coordinate');
check(e.countMainTimelines()==0 && e.getPlayingTimelineFlagsAt(0)==0,'timeline queries');
var second=new D3DLayer(d), clone=e.clone(second);
clone.setVariable('face',0.25); check(e.getVariable('face')==0.25,'clone shares native player');
clone.setRot(0.5); clone.setScale(1); clone.setCoord(0,0); clone.setColor(0xffffffff);
root.drawPlane=1; root.frontIndex=3; root.backIndex=4;
check(root.drawPlane==1 && root.frontIndex==3 && root.backIndex==4,'Layer extension');
layer.onUpdate=function(diff) { global.e.progress(diff); };
w.drawDevice=d; check(w.drawDevice===d && d.primaryLayers.count==2,'window binding');
d.update(1); d.update(1);
// Finish this script update so the host can present before device teardown.
System.wait(0);
d.startTransition(%[]); d.transState=0; d.update(1);
var other=new Window(); other.drawDevice=d;
check(w.drawDevice===void && other.drawDevice===d,'device moves between windows');
d.update(1); invalidate d; check(other.drawDevice===void,'device invalidation detaches');
invalidate other; invalidate w;
check(Plugins.unlink('drawdeviceD3D.dll'), 'unlink device');
check(e.getVariable('face')==0.25, 'existing player retains class methods after unlink');
check(Plugins.unlink('motionPlayer.dll') && Plugins.unlink('emoteplayer.dll'), 'unlink Motion aliases');
42;
