// Uses the generated assets from ffmpeg_wave.py.
function check(v,m){if(!v)throw m;}
Plugins.link('getSample.dll');
var sound = new WaveSoundBuffer(global);
sound.volume=0;
check(!sound.useVisBuffer,'visualization is opt-in');
check(sound.getSample()==0 && !sound.useVisBuffer,'legacy does not enable capture');
WaveSoundBuffer.setDefaultCounts(256);
WaveSoundBuffer.setDefaultAheads(4);
check(sound.sampleCount==256 && sound.sampleAhead==4 && sound.useVisBuffer,'lazy defaults enable capture');
WaveSoundBuffer.setDefaultCounts(512);
WaveSoundBuffer.setDefaultAheads(0);
var other = new WaveSoundBuffer(global);
check(other.sampleCount==512 && other.sampleAhead==0 && sound.sampleCount==256,'defaults affect later attachments');
sound.sampleAhead=0;
sound.open('target/ffmpeg-wave/source.wav');
sound.play();System.wait(40);
var peak=sound.sampleValue;
check(peak>0.003 && peak<0.004,'real PCM peak despite volume zero: '+peak);
check(sound.getSample(256)>1000,'legacy positive-only average');
sound.paused=true;
check(sound.sampleValue==0,'paused PCM unavailable');
sound.samplePos=12000;sound.paused=false;System.wait(20);
check(sound.sampleValue>0.003,'PCM after exact seek');
sound.useVisBuffer=false;
check(sound.sampleValue==0 && !sound.useVisBuffer,'capture only auto-enabled on first attachment');
sound.useVisBuffer=true;
sound.sampleCount=0;check(sound.sampleValue==0,'zero count');sound.sampleCount=256;
sound.sampleAhead=100000;check(sound.sampleValue==0,'unavailable ahead');sound.sampleAhead=0;
var nativeVis=sound.getVisBuffer, calls=0;
sound.getVisBuffer=function(buffer,count,channels,ahead){++calls;return nativeVis(buffer,count,channels,ahead);};
check(sound.sampleValue>0 && calls==1,'dynamic getVisBuffer override');
sound.getSample();check(calls==1,'discarded legacy result skips sampling');
sound.stop();check(sound.sampleValue==0,'stopped PCM unavailable');
Plugins.link('wuopus.dll');sound.open('target/ffmpeg-wave/source.opus');sound.play();System.wait(30);
check(sound.sampleValue>0,'Opus source PCM');sound.stop();Plugins.unlink('wuopus.dll');
Plugins.link('wuffmpeg.dll');sound.open('target/ffmpeg-wave/source.m4a');sound.play();System.wait(30);
check(sound.sampleValue>0,'AAC source PCM');sound.stop();Plugins.unlink('wuffmpeg.dll');
check(Plugins.unlink('getSample.dll'),'unlink');Plugins.link('getSample.tpm');
check(sound.sampleCount==256 && other.sampleCount==512,'instance state survives relink');
invalidate sound;invalidate other;Plugins.unlink('getSample.tpm');
Debug.message('GET_SAMPLE_OK: all exports, defaults, PCM, mute, pause, seek, ahead, overrides and reload');
'passed';
