var rect=new KRect(1,2,3,4,99);
check(rect.left==1 && rect.top==2 && rect.right==4 && rect.bottom==6 && rect.width==3 && rect.height==4, "rectangle constructor and extra args");
check(rect.isValid && rect.contains(1,6) && !rect.contains(4,3), "inclusive bottom exclusive right");
rect.left=2;rect.top=3;rect.right=8;rect.bottom=9;rect.width=10;rect.height=20;
check(rect.right==12 && rect.bottom==23, "all rectangle setters");
var duplicate=rect.dup();duplicate.left=99;
check(rect.left==2, "dup is independent");
duplicate.assign(rect);check(duplicate.left==2 && duplicate.right==12, "assign copies coordinates");
var other=new KRect(12,3,2,2);
check(!rect.intersects(other), "edge touching is not overlap");
duplicate.intersectWith(other);check(duplicate.isValid && duplicate.width==0, "zero width intersection valid");
duplicate.assign(new KRect(0,0,1,1));duplicate.include(new KRect(2,3,4,5));
check(duplicate.right==6 && duplicate.bottom==8, "include bounding box");
duplicate.unionWith(new KRect(-2,-3,1,1));check(duplicate.left==-2 && duplicate.top==-3, "unionWith alias");
duplicate.intersectWith(new KRect(99,99,1,1));check(!duplicate.isValid, "disjoint intersection remains reversed");
var nanRect=new KRect(realNan,0,1,1), normal=new KRect(0,0,1,1);
normal.include(nanRect);check(!normal.isValid, "right operand NaN wins ternary");
nanRect.include(new KRect(0,0,1,1));check(nanRect.isValid, "left operand NaN replaced");
var zeroRect=new KRect(0,0,1,1), negative=new KRect(0,0,1,1);negative.left=minusZero;
zeroRect.include(negative);check((1.0/zeroRect.left)<0, "right operand negative zero retained");
var region=new KRegion();check(region.empty && region.rectCount==0, "empty region constructor");
region.assign(new KRect(0,0,10,10));region.exclude(new KRect(3,2,4,6));
check(region.rectCount==4, "exclude partitions four rectangles");
function coords(r){return [int r.left,int r.top,int r.right,int r.bottom].join(",");}
check(coords(region.rectAt(0))=="0,0,10,2" && coords(region.rectAt(1))=="0,8,10,10" && coords(region.rectAt(2))=="0,2,3,8" && coords(region.rectAt(3))=="7,2,10,8", "partition top bottom left right order");
check(coords(region.rectAt(4294967296))==coords(region.rectAt(0)), "rectAt uint narrowing");
duplicate=region.rectAt(0);duplicate.left=99;check(region.rectAt(0).left==0, "rectAt duplicates");
check(region.contains(0,2) && !region.contains(4,4) && region.intersects(new KRect(0,0,1,1)), "region predicates");
var region2=new KRegion();region2.assign(region);region.clear();check(region.empty && region2.rectCount==4, "region assign copies and clear");
region.assign(new KRect(0,0,2,2));region.include(new KRect(1,0,2,2));
check(region.rectCount==2 && coords(region.rectAt(1))=="2,0,3,2", "include removes prior coverage and appends");
region2.assign(new KRect(0,0,1,1));region2.include(new KRect(2,0,1,1));
region.intersectWith(region2);check(region.rectCount==3, "region intersection retains touching zero width pieces");
check(coords(region.rectAt(0))=="0,0,1,1" && coords(region.rectAt(1))=="2,0,2,1" && coords(region.rectAt(2))=="2,0,3,1", "region intersection input outer loop order");
region.exclude(region2);check(region.rectCount==1 && region.rectAt(0).width==0, "exclude preserves nonintersecting zero area");
region.assign(new KRect(2,3,-1,0));check(!region.empty && !region.rectAt(0).isValid, "assign retains invalid rect");
region.assign(new KRegion());check(region.empty, "assign empty region");
