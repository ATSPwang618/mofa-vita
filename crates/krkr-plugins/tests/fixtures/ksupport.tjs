check(caught, "enum requires object variant");
var joined=unionDictionary(%[a:1,same:2], %[b:3,same:4]);
check(joined.a==1 && joined.b==3 && joined.same==4, "dictionary union overwrites");
var stored=0;
property writable { getter {return stored;} setter(v) {stored=v;} }
joined=unionDictionary(%[x:&writable],%[x:9]);
check(stored==9 && ((&joined.x) instanceof "Property"), "dictionary union invokes previous setter");
check(unionSet([3,1,1],[2,1,1,1]).join(",")=="1,1,1,2,3", "multiset union maximum multiplicity");
check(intersectionSet([3,1,1],[1,2]).join(",")=="1", "multiset intersection");
check(differenceSet([3,1,1],[1,2]).join(",")=="1,3", "multiset difference");
check(unionSet(["9","10"],["2"]).join(",")=="10,2,9", "string ordering");
check(intersectionSet([1],[1.0])[0]===1, "equivalent set representatives from left");
