check(!equalStruct([left,left], [right,right]) && getterCount==2, "repeat shared pair calls getter again");
getterCount=0;
check(!equalStruct(%[x:2], %[x:&varying]) && getterCount==1, "right accessor invoked once");
getterCount=0;
check(!equalStruct(%[x:&varying], %[x:1]) && getterCount==0, "left enumeration remains raw");
var same=function() {};
check(equalStruct(same incontextof %[], same incontextof %[]), "object identity ignores this");
