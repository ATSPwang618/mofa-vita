var derivedMissingCalls=0, derivedMissingMode=0;
class DerivedDictionary extends Dictionary {
    function DerivedDictionary() { super.Dictionary(); }
    function missing(set,name,value) {
        if (name=="leftOnly") {
            ++global.derivedMissingCalls;
            if (global.derivedMissingMode==1) { *value=void; return true; }
            if (global.derivedMissingMode==2) throw "derived missing failure";
        }
        return false;
    }
}
var derivedLeft=new DerivedDictionary(), derivedRight=new DerivedDictionary();
derivedLeft.leftOnly=7;derivedRight.rightOnly=7;armMissing(derivedRight);
check(equalStruct(derivedLeft,derivedRight) && equalStructNumericLoose(derivedLeft,derivedRight) && derivedMissingCalls==2, "derived Dictionary missing status is skipped after handler");
derivedMissingMode=1;
check(!equalStruct(derivedLeft,derivedRight), "derived missing successful void is compared");
derivedMissingMode=2;
var derivedThrown=false;
try {equalStruct(derivedLeft,derivedRight);} catch(e) {derivedThrown=e=="derived missing failure";}
check(derivedThrown, "derived missing exception is not a missing status");
