// One whole-plugin desktop scenario. All pixel assertions use real GPU images.
System.exitOnWindowClose=false;
function check(ok,msg) { if(!ok) throw msg; }
function fails(fn) { try { fn(); } catch(e) { return true; } return false; }
Plugins.link('layerExImage.dll');
var w=new Window(); w.caption='layerExImage alignment'; w.setInnerSize(980,210);
var root=new Layer(w,null); root.setSize(980,210);
var a=new Layer(w,root), saved=new Layer(w,root);
a.setImageSize(4,4); a.face=dfAlpha; a.fillRect(0,0,4,4,0x00204060);
a.setMaskPixel(1,1,128); a.face=dfProvince; a.fillRect(0,0,4,4,7);
saved.assignImages(a); a.setClip(1,1,2,2); a.holdAlpha=true;
a.update=function(){throw 'instance update must not override cached class method';};
check(a.light(10,0,'ignored')===void,'void return');
check(a.getMainPixel(1,1)==0x2a4a6a && a.getMainPixel(2,2)==0x2a4a6a,'light includes transparent RGB');
check(a.getMainPixel(0,0)==0x204060 && a.getMaskPixel(1,1)==128 && a.getMaskPixel(2,2)==0,'clip and alpha');
check(a.getProvincePixel(1,1)==7 && saved.getMainPixel(1,1)==0x204060,'province and COW');
a.setClip(0,0,4,4); a.face=dfAlpha; a.fillRect(0,0,4,4,0x80204060);
a.colorize(0,0,1); check(a.getMainPixel(0,0)==0x404040 && a.getMaskPixel(0,0)==128,'colorize HSL lightness');
a.fillRect(0,0,4,4,0x80ff0000); a.modulate(120,0,0);
check(((a.getMainPixel(0,0)>>8)&255)>=254 && (a.getMainPixel(0,0)&0xff00ff)<=1,'HSL hue rotation');
a.modulate(0,0,-100); check(a.getMainPixel(0,0)==0 && a.getMaskPixel(0,0)==128,'HSL luminance and alpha');
a.setImageSize(2,2); a.face=dfAlpha; a.fillRect(0,0,2,2,0x80787878); a.generateWhiteNoise();
var gray=[0,144,49,207];
for(var i=0;i<4;i++) check(a.getMainPixel(i%2,int(i/2))==gray[i]*0x010101 && a.getMaskPixel(i%2,int(i/2))==128,'CRT white noise stream');
a.setImageSize(2,1); a.fillRect(0,0,2,1,0x80808080); a.noise(128);
check(a.getMainPixel(0,0)==0x6d7e8a && a.getMainPixel(1,0)==0x9fa9b2,'continued BGR noise stream');
a.setImageSize(7,7); a.fillRect(0,0,7,7,0); a.fillRect(3,0,1,7,0xffffffff); a.gaussianBlur(1);
check(a.getMainPixel(2,3)==0x555555 && a.getMainPixel(3,3)==0x565656 && a.getMainPixel(4,3)==0x555555,'CxImage integrated kernel, not box blur');
check(a.getMaskPixel(2,3)==85 && a.getMaskPixel(3,3)==86,'Gaussian includes alpha');
check(a.getMainPixel(1,3)==0 && a.getMainPixel(5,3)==0,'Gaussian support');
a.gaussianBlur(0); check(a.getMainPixel(3,3)==0x565656,'zero radius');
check(fails(function(){a.light(1);}) && fails(function(){a.colorize(1,2);}) && fails(function(){a.modulate(1,2);}) && fails(function(){a.noise();}) && fails(function(){a.gaussianBlur();}),'all argument counts');
check(fails(function(){a.gaussianBlur(1.0/0.0);}) && fails(function(){a.colorize(0,0,0.0/0.0);}), 'nonfinite parameters');
var old=a.light; check(fails(function(){(old incontextof %[])(0,0);}), 'receiver validation');

// Class property/method objects are captured at first use on each receiver.
var clipReads=0, updates=0, oldClip=&Layer.clipLeft, oldUpdate=Layer.update;
class Clip { property clipLeft { getter() { global.clipReads++; return (global.clipReads%2)==0 ? 1.25 : 1; } } }
&Layer.clipLeft=&Clip.clipLeft;
Layer.update=function(l,t,width,height){check(l==1.25 && width==2,'redraw preserves original Variant arguments');global.updates++;};
var probe=new Layer(w,root); probe.setImageSize(4,4); probe.setClip(1,1,2,2);
probe.light(0,0);
&Layer.clipLeft=(&oldClip incontextof null); Layer.update=(oldUpdate incontextof null);
probe.light(0,0);
check(clipReads==4 && updates==2,'cached class accessors and repeated redraw reads');
Plugins.unlink('layerExImage.dll'); check(typeof Layer.light=='undefined','unload exports');
old(0,0); Plugins.link('layerExImage.tpm');

root.face=dfAlpha; root.fillRect(0,0,980,210,0xff14202c); root.font.height=16;
var board=new Layer(w,root); board.setImageSize(128,128); board.face=dfAlpha;
for(var y=0;y<8;y++) for(var x=0;x<8;x++) board.fillRect(x*16,y*16,16,16,((x+y)%2)?0xff297dba:0xfff3e8c4);
board.fillRect(0,0,24,24,0xffef5350); board.fillRect(48,48,32,32,0xff46c77e);
var labels=['SOURCE','LIGHT','COLORIZE','MODULATE','NOISE','WHITE','GAUSSIAN'];
for(var i=0;i<7;i++) {
    var panel=new Layer(w,root); panel.assignImages(board);
    if(i==1) panel.light(30,30);
    else if(i==2) panel.colorize(150,160,0.8);
    else if(i==3) panel.modulate(120,20,0);
    else if(i==4) panel.noise(160);
    else if(i==5) panel.generateWhiteNoise();
    else if(i==6) panel.gaussianBlur(4);
    root.copyRect(i*140+6,48,panel,0,0,128,128);
    root.drawText(i*140+6,18,labels[i],0xffffff);
    invalidate panel;
}
root.saveLayerImage('target/layer-ex-image-output.png','png');
w.visible=true; System.wait(80);
invalidate probe; invalidate board; invalidate saved; invalidate a;
Plugins.unlink('layerExImage.tpm'); invalidate root; invalidate w;
Debug.message('LAYER_EX_IMAGE_OK six filters, pixels, clipping, alpha, COW, cached accessors and reload');
'passed';
