function check(v,s) {if(!v) throw s;}
System.exitOnWindowClose=false;
Plugins.link('layerExImage.dll');Plugins.link('layerExFilter.dll');Plugins.link('filter.dll');
var w=new Window();w.setInnerSize(13,9);
var root=new Layer(w,null);root.setSize(13,9);
var l=new Layer(w,root),saved=new Layer(w,root);
l.setSize(13,9);l.setImageSize(13,9);
l.face=dfProvince;l.fillRect(0,0,13,9,53);
l.face=dfAlpha;l.fillRect(0,0,13,9,0x80402010);saved.assignImages(l);
l.light(10,0);
check(l.getMainPixel(0,0)==0x4a2a1a && l.getMaskPixel(0,0)==128,'lookup brightness');
l.colorize(0,0,1.0);l.modulate(360,0,0);
check(l.getMainPixel(0,0)==0x323232 && l.getMaskPixel(0,0)==128,'colorize and HSL wrap');
l.generateWhiteNoise();
check(l.getMainPixel(0,0)==0 && l.getMainPixel(1,0)==0x909090,'MSVCRT white noise sequence');
l.noise(0);
check(l.getMainPixel(1,0)==0x909090 && l.getMaskPixel(1,0)==128,'zero-level noise and alpha');
l.drawNoise(0,0,255,123,0,0,13,9,1);
check(l.getMainPixel(0,0)==0x23eb3d && l.getMaskPixel(0,0)==128,'packed full-color LCG and held alpha');
var tail=l.getMainPixel(12,0);
Noise(%[layer:l,monocro:0,seed:123,under:0,upper:255]);
check(l.getMainPixel(0,0)==0x745c6b && l.getMaskPixel(0,0)==255,'legacy packed leading tail');
check(l.getMainPixel(12,0)==tail && l.getMaskPixel(12,0)==128,'legacy unwritten trailing tail');
Noise(%[layer:l,monocro:1,seed:-1,under:0,upper:255]);
check(l.getMainPixel(0,0)==0xa2a2a2 && l.getMaskPixel(0,0)==93,'legacy monochrome high-product alpha');
l.fillRect(0,0,13,9,0x407391b5);fillXor(l,0,0,13,9,0xa12e3c57);
check(l.getMainPixel(0,0)==0x5dade2 && l.getMaskPixel(0,0)==225,'all-channel XOR');
l.fillRect(0,0,13,9,0x80fbfafd);dithering(l,0,0,13,9);
check(l.getMainPixel(0,0)==0xfcfcfc && l.getMainPixel(1,0)==0xfcf8fc && l.getMaskPixel(0,0)==128,'dither thresholds and alpha');
check(l.getProvincePixel(0,0)==53 && saved.getMainPixel(0,0)==0x402010 && saved.getMaskPixel(0,0)==128,'filters preserve province and snapshots');
