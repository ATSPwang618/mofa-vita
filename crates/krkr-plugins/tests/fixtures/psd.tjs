// Desktop fixture; PSD data is generated by krkr-image's complete format scenario.
System.exitOnWindowClose=false;
function check(ok,message) { if(!ok) throw message; }
function fails(fn) { try {fn();} catch(e) {return true;} return false; }
Plugins.link("psd.dll"); Plugins.link("fstat.dll");
Storages.addAutoPath("target/psd/");
var p=new PSD("ignored");
check(p.width==-1 && p.height==-1 && p.channels==-1 && p.depth==-1 && p.color_mode==-1 && p.layer_count==-1,"unloaded properties");
check(PSD.color_mode_rgb==3 && PSD.blend_mode_divide==27 && PSD.layer_type_folder==2,"constant exports");
check(fails(function(){p.getGuides();}) && fails(function(){p.getLayerName(0);}),"unloaded errors");
var w=new Window(); w.caption="PSD alignment"; w.setInnerSize(640,360);
var root=new Layer(w,null); root.setSize(640,360);
var raw=new Layer(w,root), masked=new Layer(w,root), mask=new Layer(w,root), merged=new Layer(w,root), fromStorage=new Layer(w,root);
check(p.getBlend(merged)==false,"unloaded merged result");
for(var depth=8;depth<=32;depth*=2) for(var compression=0;compression<=3;compression++) {
    check(p.load("target/psd/scene-"+depth+"-"+compression+".psd"),"PSD load");
    check(p.width==6 && p.height==5 && p.channels==4 && p.depth==depth && p.layer_count==5 && p.color_mode==3,"PSD header");
    check(p.getLayerName(2)=="彩/色" && p.getLayerType(2)==PSD.layer_type_normal && p.getLayerType(3)==PSD.layer_type_folder,"layer classification");
    var info=p.getLayerInfo(2);
    check(info.width==3 && info.height==2 && info.left==1 && info.top==2 && info.bottom==4 && info.right==4,"layer rectangle");
    check(info.opacity==200 && info.fill_opacity==170 && info.mask && info.type==ltPsNormal && info.blend_mode==0,"layer appearance");
    check(info.visible && info.layer_type==0 && info.layer_id==42 && info.group_layer_id==43 && info.clipping==0 && !info.obsolete && !info.transparency_protected && !info.pixel_data_irrelevant,"layer flags");
    check(info.layer_comp[9].id==9 && info.layer_comp[9].offset_x==7 && info.layer_comp[9].offset_y==-3 && !info.layer_comp[9].enable,"layer comp offsets");
    var guides=p.getGuides(), slices=p.getSlices(), comps=p.getLayerComp();
    check(guides.horz_grid==576 && guides.vert_grid==640 && guides.vertical[0]==32 && guides.horizontal[0]==64,"raw guide units");
    check(slices.left==1 && slices.top==2 && slices.name=="Slices" && slices.slices[0].id==5 && slices.slices[0].associated_layer_id==42 && slices.slices[0].cell_text=="cell" && slices.slices[0].color==(0xff0a141e-0x100000000),"slice records");
    check(comps.last_applied_id==9 && comps.comps[0].name=="Scene" && comps.comps[0].comment=="note" && comps.comps[0].record_visibility && comps.comps[0].record_position && comps.comps[0].record_appearance,"document comps");
    check(p.getLayerDataRaw(raw,2)===void,"raw result");
    check(raw.left==1 && raw.top==2 && raw.width==3 && raw.height==2 && raw.imageLeft==0 && raw.imageTop==0 && raw.name=="彩/色" && raw.fill_opacity==170 && raw.type==ltPsNormal,"target properties");
    check(raw.getMainPixel(0,0)==0xff0000 && raw.getMainPixel(1,0)==0x00ff00 && raw.getMainPixel(2,0)==0x0000ff && raw.getMainPixel(1,1)==0x285078,"raw RGB");
    check(raw.getMaskPixel(1,0)==128 && raw.getMaskPixel(2,0)==64,"raw alpha");
    p.getLayerData(masked,2); p.getLayerDataMask(mask,2);
    check(Math.abs(masked.getMaskPixel(1,0)-64)<=1 && masked.getMaskPixel(2,0)==0 && mask.getMainPixel(1,0)==0x808080 && mask.getMaskPixel(1,0)==255,"mask transfer");
    check(mask.opacity==255 && mask.fill_opacity==255 && mask.defaultMaskColor==0,"mask properties");
    check(p.getBlend(merged) && merged.width==6 && merged.height==5 && merged.getMainPixel(5,4)==0x0c2238,"stored merged image");
    var url="psd://scene-"+depth+"-"+compression+".psd/root/group/inner/彩_色.bmp";
    check(Storages.isExistentStorage(url) && Storages.getLocalName(url)=="","virtual storage resolution");
    fromStorage.loadImages(url);
    check(fromStorage.getMainPixel(0,0)==0xff0000 && Math.abs(fromStorage.getMaskPixel(1,0)-64)<=1,"virtual BMP pixels");
}
var domain="psd://scene-32-3.psd/";
check(Storages.dirlist(domain+"id/")[0]=="42.bmp" && Storages.dirlist(domain+"root/group/inner/")[0]=="彩_色.bmp","virtual directory listing");
check(!Storages.isExistentStorage(domain+"id/no.bmp") && !Storages.isExistentStorage(domain+"root/missing.bmp"),"missing virtual layers");
fromStorage.loadImages(domain+"id/42.bmp");
check(fromStorage.getMainPixel(0,1)==0xffffff,"ID storage read");
PSD.clearStorageCache();
check(Storages.isExistentStorage(domain+"id/42.bmp"),"loaded object survives cache clear");
p.getLayerDataMask(mask,3);
check(mask.width==1 && mask.height==1 && mask.left==0 && mask.top==0 && mask.getMainPixel(0,0)==0 && mask.getMaskPixel(0,0)==255,"dummy folder mask");
check(fails(function(){p.getLayerData(raw,3);}) && fails(function(){p.getLayerInfo(-1);}) && fails(function(){p.getLayerData(new Bitmap(1,1,32),2);}),"invalid layer requests");
var before=raw.getMainPixel(0,0);
var propertyMarker=0;
property stoppedOpacity { setter(value) {global.propertyMarker=value; throw "setter stopped transfer";} }
&raw.fill_opacity=&stoppedOpacity;
check(fails(function(){p.getLayerDataRaw(raw,2);}) && propertyMarker==170 && raw.getMainPixel(0,0)==before,"script setter error reaches caller");
delete raw.fill_opacity;
check(!p.load("not-here.psd") && p.width==-1,"failed reload clears old state");
// Auto-load through the medium after the explicit PSD object releases its source.
PSD.clearStorageCache(); fromStorage.loadImages(domain+"id/42.bmp");
check(fromStorage.getMainPixel(0,0)==0xff0000,"automatic backing PSD load");
var retainedClass=PSD;
Plugins.unlink("psd.dll"); check(typeof global.PSD=="undefined","plugin export removal");
Plugins.link("psd.tpm"); check(typeof PSD=="Object","plugin alias reload");
var again=new PSD(); check(again.load("scene-8-0.psd"),"reloaded provider");
// Export a larger comparison image through real Layer stretch and PNG saving.
var board=new Layer(w,root); board.setImageSize(480,240); board.face=dfAlpha;board.fillRect(0,0,480,240,0xff202028);
again.getLayerDataRaw(raw,2);again.getLayerData(masked,2);again.getLayerDataMask(mask,2);
board.stretchCopy(0,0,160,120,raw,0,0,3,2);
board.stretchCopy(160,0,160,120,masked,0,0,3,2);
board.stretchCopy(320,0,160,120,mask,0,0,3,2);
again.getBlend(merged);board.stretchCopy(0,120,480,120,merged,0,0,6,5);
board.saveLayerImage("target/psd-output.png","png");
invalidate w;
Debug.message("PSD desktop passed: all public methods, properties, metadata, pixels and storage");
"passed";
