function check(v,m){if(!v)throw m;}
Plugins.link('textrender.dll');Plugins.link('sqlite3.dll');
var r = new TextRenderBase();
r.setRenderSize(400,200);
check(r.render('AB',0,0,0,false),'render');
check(r.calcShowCount()==0 && r.renderCount==0,'buffered until flush');
r.done();var chars=r.getCharacters(0,0);
check(chars.count==2 && chars[0].cw>0 && chars[1].x==chars[0].cw,'real font advances');
check(r.renderText=='AB' && r.renderCount==2,'flushed text');
check(r.getCharacters(1,2).count==0 && r.getCharacters(2,1).count==2,'reference ranges');
r.setDefault(%['fontsize'=>32,'bold'=>false,'align'=>0,'valign'=>-1]);
check(r.defaultFontSize==32,'default dictionary');r.clear();r.render('AB',0,0,0,false);r.done();chars=r.getCharacters(0,0);
check(chars[0].x==int((400-chars[0].cw-chars[1].cw)/2),'center alignment');
r.setDefault(%['align'=>-1]);r.clear();
r.render('%b1A#ff0000;B\nC&target/text-sqlite/icon.png;',0,0,0,false);r.done();chars=r.getCharacters(0,0);
check(chars.count==4 && chars[0].bold && chars[1].color==0xff0000,'style controls');
check(chars[2].y>chars[0].y && chars[3].graph && chars[3].cw==7 && chars[3].size==5,'line break and image metadata');
check(chars[0].shadow===void && !chars[0].vertical,'reference character fields');
r.clear();r.render('Q',0,0,0,false);r.clear();r.done();check(r.renderText=='Q','reference retains pending buffer across clear');
check(r.keyWait.count==0 && r.getKeyWait().count==0,'key wait getter');
var failed=false;try{r.render('%b2',0,0,0,false);}catch(e){failed=true;}check(failed,'invalid format');
r.fontSize=99;r.resetStyle();check(r.fontSize==32,'reset style');
failed=false;try{r.renderCount=5;}catch(e){failed=true;}check(failed,'read-only counts');

var db=new Sqlite(':memory:');
check(db.errorCode==Sqlite.SQLITE_OK,'database open');
check(db.exec('CREATE TABLE sample(id INTEGER PRIMARY KEY, title TEXT, data BLOB)'),'create');
check(db.exec('INSERT INTO sample VALUES(?,?,?)',[1,'abc',<%0001ff%>]),'array binding');
check(db.exec('INSERT INTO sample VALUES(?,?,?)',[2,'日本語',void]),'second row');
check(db.lastInsertRowId==2,'row id');
check(db.execValue('SELECT title FROM sample WHERE id=?',[2])=='日本語','scalar result');
check(db.execValue('SELECT :n',%[':n'=>99])==0,'reference dictionary binds member flags');
check(db.execValue("SELECT cnt('Abc','bc')")==1 && db.execValue("SELECT ncnt('ＡＢＣが','abcカ')")==1,'contain functions');
check(db.begin() && db.exec('INSERT INTO sample VALUES(3,\'rolled back\',NULL)') && db.rollback(),'rollback');
check(db.execValue('SELECT count(*) FROM sample')==2,'transaction isolation');
check(db.begin() && db.commit(),'commit');
check(db.exec('CREATE TRIGGER inserted AFTER INSERT ON sample BEGIN UPDATE sample SET title=upper(title) WHERE id=new.id; END;'),'complete trigger SQL');
check(db.exec("INSERT INTO sample VALUES(3,'third',NULL); INVALID TRAILING SQL"),'first SQL only');
check(db.execValue('SELECT title FROM sample WHERE id=3')=='THIRD','trigger executes');
var count=0;check(db.exec('SELECT id,title FROM sample ORDER BY id',[],function(id,title){++count;check(db.execValue('SELECT count(*) FROM sample')==3,'reentrant callback');return false;}),'callback exec');
check(count==3,'callback return ignored');
var s=new SqliteStatement(db,'SELECT id AS ID,title,data FROM sample ORDER BY id');
var other=new SqliteStatement(db,'SELECT count(*) AS n FROM sample');
check(s.columnCount==3 && s.count==0 && s.step(),'statement first row');
check(s.ID==1 && s.get('TITLE')=='abc' && s.getType('ID')==SqliteStatement.SQLITE_INTEGER,'column access and missing');
check(s.get('data')===<%0001ff%> && s.get().count==3,'blob and full row');
check(other.step() && other.n==3 && s.step() && s.ID==2,'interleaved live cursors');
check(s.isNull('data') && s.get('data','fallback')=='fallback','null default');
check(s.exec()==Sqlite.SQLITE_ROW && s.ID==3 && s.exec()==Sqlite.SQLITE_DONE && s.count==0,'exec and automatic reset');
check(s.step() && s.ID==1 && s.reset()==0,'explicit reset');
check(s.open('SELECT ? + ? AS answer')==0 && s.bindAt(10)==0 && s.bindAt(32)==0 && s.step() && s.answer==42,'sequential binding');
check(s.reset()==0 && s.bind([20,22])==0 && s.step() && s.get(0)==42,'bind array after reset');
s.close();check(s.sql=='' && s.columnCount==0,'close');
check(!db.exec('INVALID SQL') && db.errorCode!=0 && db.errorMessage!='','SQL error reporting');
var disk=new Sqlite('target/text-sqlite/data.sqlite',true);
var archive=new Sqlite('target/text-sqlite/data.xp3>data.sqlite',true);
check(disk.execValue('SELECT title FROM fixture')=='参照データ' && archive.execValue('SELECT id FROM fixture')==7,'VFS read-only databases');
check(!archive.exec('DELETE FROM fixture') && archive.errorCode==Sqlite.SQLITE_READONLY,'read-only enforcement');
var missing=new Sqlite('target/text-sqlite/missing.sqlite',true);check(missing.errorCode==Sqlite.SQLITE_CANTOPEN,'open failure state');
invalidate missing;invalidate archive;invalidate disk;invalidate other;invalidate s;invalidate db;invalidate r;
check(Plugins.unlink('sqlite3.dll') && Plugins.unlink('textrender.dll'),'unlink');
Plugins.link('sqlite3.tpm');Plugins.link('textrender.tpm');Plugins.unlink('sqlite3.tpm');Plugins.unlink('textrender.tpm');
Debug.message('TEXT_SQLITE_OK: layout, controls, graphics, live cursors, callbacks, transactions, VFS and reload');
'passed';
