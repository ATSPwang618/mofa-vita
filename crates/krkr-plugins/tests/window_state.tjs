// One Windows desktop capability fixture. Run with `krkr-rs engine run <file> --host desktop`.
// Source: wamsoft/windowEx 88c9be22ff8f9e6d42edbf4787092837f177a89a,
// main.cpp SetRect, SC_* commands, state setters, client/normal rectangles.
// Actual native windows are required; this does not use mock acknowledgements.
// Every state operation has a host deadline; all windows are closed on success.
System.exitOnWindowClose = false;
Plugins.link("windowEx.dll");
function check(value, message) { if (!value) throw message; }
function same(a, b) { return a.x == b.x && a.y == b.y && a.w == b.w && a.h == b.h; }
class ProbeWindow extends Window {
    var moves = 0, minimizes = 0, maximizes = 0, veto = false;
    function onMove(x, y) { check(typeof x == "Integer" && typeof y == "Integer", "move coordinates"); moves++; }
    function onMinimize() { minimizes++; }
    function onMaximize() { maximizes++; }
    function onMaximizeQuery() { return veto; }
    function ProbeWindow() { super.Window(); caption = "windowEx state fixture"; }
}
var w = new ProbeWindow();
w.registerExEvent();
check(!w.visible && !w.maximized && !w.minimized, "initial state");
w.maximized = false;
w.minimized = false;
check(!w.visible, "unchanged state setters must not show a hidden window");
w.showRestore();
check(w.visible && !w.maximized && !w.minimized, "restore must show a hidden normal window");
w.setInnerSize(360, 220);
w.setPos(140, 160);
var outer = w.getWindowRect(), client = w.getClientRect(), normal = w.getNormalRect();
check(outer instanceof "Dictionary" && client instanceof "Dictionary", "rectangle type");
check(outer !== w.getWindowRect(), "rectangle calls must allocate fresh dictionaries");
check(outer.x == w.left && outer.y == w.top && outer.w == w.width && outer.h == w.height, "confirmed outer geometry");
check(client.w == 360 && client.h == 220 && client.x >= outer.x && client.y > outer.y, "client rectangle uses screen coordinates");
check(same(outer, normal), "normal geometry before maximize");
check(w.getNormalRect(true) === void, "unavailable workspace placement must not invent screen-relative coordinates");
check(w.setClientRect(%["x" => 900, "y" => 950, "w" => 370, "h" => 230]), "setClientRect result");
var resizedClient = w.getClientRect();
check(resizedClient.x == client.x && resizedClient.y == client.y && resizedClient.w == 370 && resizedClient.h == 230,
      "upstream SWP_NOMOVE ignores x/y while setting client size");
check(w.setClientRect(%["w" => 360]) && w.getClientRect().h == 230, "omitted rectangle fields retain current dimensions");
w.setInnerSize(360, 220);
System.wait(30);
check(w.moves > 0, "registered real move callback");

var monitors = System.getDisplayMonitors();
check(monitors instanceof "Array" && monitors.count > 0, "real display enumeration");
var display = monitors[0].monitor;
check(display.w > 0 && display.h > 0 && monitors[0].work instanceof "Dictionary" &&
      monitors[0].work.w > 0 && monitors[0].work.h > 0, "monitor and portable work rectangles");
check(same(monitors[0].intersect, display), "unfiltered monitor intersection");
var selected = System.getMonitorInfo(false, display.x, display.y);
check(selected instanceof "Dictionary", "monitor point selection");
check(System.getMonitorInfo(false, -1000000000, -1000000000) === void, "outside monitor without nearest");
check(System.getMonitorInfo(true, -1000000000, -1000000000) instanceof "Dictionary", "nearest monitor selection");
check(System.getMonitorInfo(true, w) instanceof "Dictionary", "managed window monitor query");
var clipped = System.getDisplayMonitors(display.x, display.y, 1, 1);
check(clipped.count >= 1 && clipped[0].intersect.w == 1 && clipped[0].intersect.h == 1, "monitor rectangle intersection");
check(System.getSystemMetrics("cmonitors") == monitors.count, "display-count metric");
check(System.getDoubleClickTime() > 0 && System.getSystemMetrics("CXDOUBLECLK") == 8, "shared input double-click policy");
var cursor = System.getCursorPos();
check(cursor === void || (typeof cursor.x == "Integer" && typeof cursor.y == "Integer"), "queried cursor or explicit unavailable result");
// Do not move or clip the user's cursor in this fixture.
check(typeof System.getCPUType() == "Integer" && System.getAboutString().indexOf("krkr-rs") >= 0, "engine identity and CPU feature flags");
System.eventDisabled = true;
System.breathe();
check(!System.isBreathing() && !System.eventDisabled, "breathe restores original event gate semantics");
System.clearGraphicCache();

check(Window.getNotificationNum("MOVE") == 3 && Window.getNotificationName(3) == "MOVE", "notification table directions");
check(Window.getNotificationNum("move") == -1 && Window.getNotificationName(-1) == "", "notification missing defaults and case sensitivity");
Window._Notifications["CUSTOM"] = 42;
check(Window.getNotificationNum("CUSTOM") == 42, "notification cache remains script mutable");
check(!w.setMessageHook(true, "MOVE") && !w.registerHotKey(1, 65, 0), "deprecated OS registration reports no capability");
check(w.ncHitTest(0, 0) == -2 && !w.setWindowCornerPreference(0), "native chrome query unavailable results");
w.enableNCMouseEvent = 1;
check(w.enableNCMouseEvent, "non-client event preference persists");
var systemMenu = [];
w.exSystemMenu = systemMenu;
w.resetExSystemMenu();
check(w.exSystemMenu === systemMenu, "reset system menu retains script source");
w.setOverlayBitmap();
var menu = new MenuItem(w);
menu.rightJustify = "1";
menu.bmpItem = MenuItem.biClose;
menu.bmpChecked = MenuItem.biPopupRestore;
menu.bmpUnchecked = void;
check(menu.rightJustify && menu.bmpItem == 5 && menu.bmpChecked == 9 && menu.bmpUnchecked == 0, "menu extension state");
check(menu.popupEx() == 0 && menu.popupEx(0, void, void) == 0, "no native menu selection");
check(!Debug.console.maximize() && !Debug.console.restoreMaximize() && Debug.console.getRect() === void && Debug.console.getPlacement() === void,
      "legacy console reports no native window");
Debug.console.setPos(void, void);
check(!Debug.console.setPlacement(%[]), "console placement cannot claim native success");
Debug.console.bringAfter(w);
Pad.registerExEvent();
check(!System.findWindowEx() && !System.loadCursor(-2) && !System.setDpiAwareness(-4) && System.classLongPtr(w, "UNKNOWN") === void,
      "native handle APIs preserve no-capability results");

Debug.logToFileOnError = false;
check(Scripts.setEvalErrorLog(false) == 1 && Scripts.setEvalErrorLog(false) == 0, "eval switch returns previous value");
check(Scripts.eval("6*7", "window-ex-expression", 17) == 42, "quiet eval result and source arguments");
var lastLog = Debug.getLastLog(), caught = false;
try { Scripts.eval("(function(){throw 'WINDOW_EX_QUIET';})()"); } catch(e) { caught = e == "WINDOW_EX_QUIET"; }
check(caught && Debug.getLastLog() == lastLog, "quiet eval preserves thrown value without logging");
check(Scripts.setEvalErrorLog(true) == 0, "enable eval logging");
caught = false;
try { Scripts.eval("(function(){throw 'WINDOW_EX_LOGGED';})()"); } catch(e) { caught = e == "WINDOW_EX_LOGGED"; }
check(caught && Debug.getLastLog().indexOf("WINDOW_EX_LOGGED") >= 0, "logged eval preserves throw and logs error");

check(w.maximizeBox && w.minimizeBox && !w.disableResize, "default controls");
w.maximizeBox = "0"; w.minimizeBox = 0;
check(!w.maximizeBox && !w.minimizeBox, "button setters");
w.disableResize = "1";
check(w.disableResize && !w.maximizeBox && !w.minimizeBox, "resize flag preserves buttons");
w.setInnerSize(380, 240);
check(w.getClientRect().w == 380 && w.getClientRect().h == 240, "disableResize permits programmatic geometry");
w.disableResize = false; w.maximizeBox = true; w.minimizeBox = true;
normal = w.getNormalRect();

w.veto = true;
w.maximize();
check(!w.maximized, "script maximize query can veto a programmatic maximize");
w.veto = false;
w.maximize();
check(w.visible && w.maximized && !w.minimized, "maximize state");
check(same(w.getNormalRect(), normal), "maximized normal rectangle");
var maximized = w.getWindowRect();
check(maximized.w > normal.w && maximized.h > normal.h, "maximize must actually change geometry");
w.maximized = true;
check(same(w.getWindowRect(), maximized), "idempotent maximize setter");
w.minimize();
check(w.minimized && !w.maximized, "minimized from maximized state");
check(same(w.getNormalRect(), normal), "minimized normal rectangle");
w.maximized = false;
check(w.minimized, "false maximized setter must not restore an already non-maximized window");
w.showRestore();
check(!w.minimized && w.maximized && same(w.getWindowRect(), maximized), "restore returns minimized maximized window to maximized geometry");
w.maximized = false;
check(!w.maximized && !w.minimized && same(w.getWindowRect(), normal), "restore normal geometry");
w.minimized = true;
check(w.minimized, "minimize setter");
w.minimized = false;
check(!w.minimized && !w.maximized && same(w.getWindowRect(), normal), "restore from normal minimize");
System.wait(30);
check(w.minimizes > 0 && w.maximizes > 0, "observed minimize/maximize extension events");

w.borderStyle = bsSingle;
check(!w.maximizeBox && w.minimizeBox, "border style updates button state");
w.maximize();
check(!w.maximized, "fixed window maximize is ignored");
w.borderStyle = bsSizeable;
w.bringTo("ToPmOsT"); check(w.stayOnTop, "topmost order updates shared state");
w.bringTo(-2); check(!w.stayOnTop, "normal order updates shared state");
var unsupported = 0;
try { w.sendToBack(); } catch(e) { unsupported++; }
try { w.bringTo("top", true); } catch(e) { unsupported++; }
check(unsupported == 2 && !w.stayOnTop, "unsupported stacking must report failure");
var movementUnsupported = false;
try { w.disableMove = true; } catch(e) { movementUnsupported = true; }
check(movementUnsupported && !w.disableMove, "native title bar movement limitation is explicit");
w.borderStyle = bsNone;
w.disableMove = true;
check(w.disableMove, "frameless move permission");
w.beginMove();
w.disableMove = false;
w.borderStyle = bsSizeable;
var saved = w.getClientRect;
w.close();
var invalid = false;
try { saved(); } catch(e) { invalid = true; }
check(invalid, "saved extension function must reject an invalidated window");
invalidate menu;
Plugins.unlink("windowEx.dll");
Debug.message("WINDOW_EXTENSIONS_OK");
System.exit(0);
